# Land of Devastation — example environment variables.
# Copy to `.env` for local development and fill in real values where noted.

# Postgres
DATABASE_URL=postgres://lod:lod@localhost:5432/lod_dev
# Redis
REDIS_URL=redis://localhost:6379
# Secrets — generate random values for local dev
SESSION_SECRET=change-me-32-bytes-hex
ARGON2_PEPPER=change-me-32-bytes-hex
# Server
PORT=4000
NODE_ENV=development
# Client
VITE_API_BASE=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws
