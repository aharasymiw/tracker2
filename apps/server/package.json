{
  "name": "@lod/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@lod/shared-utils": "workspace:*",
    "@lod/game-rng": "workspace:*",
    "@lod/protocol": "workspace:*",
    "@lod/game-core": "workspace:*",
    "@lod/game-content": "workspace:*",
    "fastify": "^5.0.0",
    "@fastify/websocket": "^11.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "drizzle-orm": "^0.35.1",
    "postgres": "^3.4.4",
    "ioredis": "^5.4.1",
    "@node-rs/argon2": "^2.0.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "fast-json-stringify": "^6.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/ws": "^8.5.12",
    "drizzle-kit": "^0.26.2",
    "pino-pretty": "^11.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
